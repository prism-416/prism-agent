OCI_OBJECT_STORAGE_BUCKET_NAME=

# DEV ONLY OCI API-key credentials
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_FILE=
