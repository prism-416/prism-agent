# Gemini / PydanticAI
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=google-gla:gemini-2.0-flash

# PostgreSQL / pgvector
PG_DSN=postgresql://postgres:postgres@localhost:5432/rag
EMBEDDING_DIMENSION=768

# Retrieval
RAG_TOP_K=6
RAG_SCORE_THRESHOLD=0.65

# Prompt loading
PROMPTS_DIR=prompts

# Runtime
LOG_LEVEL=INFO
MAX_WORKFLOW_RETRIES=1
LLM_TIMEOUT_SECONDS=30
